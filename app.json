{
  "expo": {
    "name": "Rutero React",
    "slug": "rutero-react",
    "version": "1.0.0",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "orientation": "portrait",
    "extra": {
      "apiBase": "http://127.0.0.1:8000",
      "appName": "Rutero",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "googleWebClientId": ""
    },
    "plugins": [
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-font",
      "expo-sharing",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "rutero",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.rutero.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.rutero.app"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
